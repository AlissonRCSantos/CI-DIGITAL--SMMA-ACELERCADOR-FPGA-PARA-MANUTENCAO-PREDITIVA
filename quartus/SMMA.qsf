# ============================================================================
# SMMA -- Smart Machine Monitoring Accelerator
# Atribuicoes do Quartus Prime
#
# Alvo: Terasic DE0-CV  --  Cyclone V 5CEBA4F23C7N  --  50 MHz
# ============================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY SMMA_Top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name SDC_FILE SMMA.sdc

# ----------------------------------------------------------------------------
# Onde o Quartus acha os .hex do $readmemh
#
# Os modulos abrem "vetores/<arquivo>.hex" por caminho RELATIVO ao diretorio
# do projeto -- isto e, quartus/vetores/. Sem esses arquivos a sintese infere
# ROMs ZERADAS e passa sem erro (o classificador responderia sempre a mesma
# classe). Por isso a pasta vetores/ fica AQUI, ao lado do .qpf.
# ----------------------------------------------------------------------------
set_global_assignment -name SEARCH_PATH vetores

# ----------------------------------------------------------------------------
# Fontes RTL (uma pasta por modulo do enunciado, secao 4)
# ----------------------------------------------------------------------------

# -- top level: controle global, comunicacao e interface de saida --
set_global_assignment -name VERILOG_FILE ../RTL/top/SMMA_Top.v
set_global_assignment -name VERILOG_FILE ../RTL/top/SMMA_Global_Control.v
set_global_assignment -name VERILOG_FILE ../RTL/top/SMMA_Panel.v
set_global_assignment -name VERILOG_FILE ../RTL/top/Stream_Fork.v

# -- interface de entrada dos sensores: dataset em ROM, FIR anti-alias, /8 --
set_global_assignment -name VERILOG_FILE ../RTL/entrada/Sample_Source.v
set_global_assignment -name VERILOG_FILE ../RTL/entrada/FIR_Decimator.v

# -- buffers de amostras e de espectros --
set_global_assignment -name VERILOG_FILE ../RTL/buffers/Frame_Builder.v
set_global_assignment -name VERILOG_FILE ../RTL/buffers/Spectrum_Accumulator.v
set_global_assignment -name VERILOG_FILE ../RTL/buffers/Spectrogram_Buffer.v

# -- modulo FFT (64 pontos) + compressao log2 do espectrograma --
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Top.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Control_FSM.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Addr_Gen.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Bit_Reverse.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Butterfly.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Memory.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Twiddle_ROM.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Magnitude.v
set_global_assignment -name VERILOG_FILE ../RTL/fft/FFT_Log2_Compress.v

# -- modulo MDC: detector de picos -> MDC (Euclides) -> frequencia fundamental --
set_global_assignment -name VERILOG_FILE ../RTL/mdc/peak_detector.v
set_global_assignment -name VERILOG_FILE ../RTL/mdc/mdc_gcd.v
set_global_assignment -name VERILOG_FILE ../RTL/mdc/f0_estimator.v

# -- modulo LMS: filtro adaptativo de 8 coeficientes --
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Filter_Top.v
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Control_FSM.v
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Input_Delay_Line.v
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Weight_Storage.v
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Processing_Element.v
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Accumulator_Error_Scale.v
set_global_assignment -name VERILOG_FILE ../RTL/lms/LMS_Residual_Feature.v

# -- modulo de inversao de matriz: autocorrelacao, Yule-Walker, Gauss-Jordan --
set_global_assignment -name VERILOG_FILE ../RTL/matriz/autocorrelacao_yw.v
set_global_assignment -name VERILOG_FILE ../RTL/matriz/Yule_Walker_Solver.v
set_global_assignment -name VERILOG_FILE ../RTL/matriz/gauss_jordan_inv.v
set_global_assignment -name VERILOG_FILE ../RTL/matriz/fixed_point_divider.v

# -- acelerador de Machine Learning: features + arvore de decisao --
set_global_assignment -name VERILOG_FILE ../RTL/ml/Feature_Spectral.v
set_global_assignment -name VERILOG_FILE ../RTL/ml/Feature_Collector.v
set_global_assignment -name VERILOG_FILE ../RTL/ml/ML_Tree_Classifier.v

# -- acelerador CNN --
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_Top.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_Control_FSM.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_Line_Buffer.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_Conv_Layer.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_MAC_Unit.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_ReLU.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_MaxPool.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_Dense_Classifier.v
set_global_assignment -name VERILOG_FILE ../RTL/cnn/CNN_Weight_ROM.v

# -- aritmetica comum (ponto fixo Q1.15) --
set_global_assignment -name VERILOG_FILE ../RTL/comum/FP_Mult_Unit.v
set_global_assignment -name VERILOG_FILE ../RTL/comum/FP_Arith_Unit.v
set_global_assignment -name VERILOG_FILE ../RTL/comum/Divider_Q15.v

# ============================================================================
# PINOS -- CONFERIR ANTES DE GRAVAR
# ============================================================================
#
# Estas atribuicoes seguem o mapeamento usual da DE0-CV, mas NAO foram
# conferidas contra o manual da sua placa. Gravar com pinos errados nao
# funciona e, nos pinos de saida, pode danificar a FPGA.
#
# A forma segura, e a que se recomenda: no Quartus, usar
#     Assignments > Import Assignments
# e importar o "DE0_CV.qsf" que acompanha o CD/Resources da Terasic. Ele traz a
# pinagem oficial, inclusive os niveis de I/O. Depois disso as linhas abaixo
# podem ser apagadas.
#
# Os nomes dos pinos do top level (CLOCK_50, KEY, SW, LEDR, HEX0..HEX5) foram
# escolhidos iguais aos do DE0_CV.qsf da Terasic exatamente para que essa
# importacao casse sem renomear nada.
# ============================================================================





# Os seis displays de 7 segmentos sao a parte da qual menos se tem certeza.
# Importe-os do DE0_CV.qsf da Terasic.
#
#   HEX0[6:0] ... HEX5[6:0]
#
# O projeto trata os segmentos como ATIVOS EM BAIXO, que e o caso na DE0-CV.

# ----------------------------------------------------------------------------
# Niveis de I/O
# ----------------------------------------------------------------------------
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ----------------------------------------------------------------------------
# Pinos nao usados: em alta impedancia, nao em terra.
#
# A DE0-CV tem pinos ligados a perifericos (SDRAM, VGA, PS/2) que este projeto
# nao usa. Deixa-los como saida em nivel baixo, que e o padrao do Quartus,
# coloca a FPGA disputando esses barramentos.
# ----------------------------------------------------------------------------
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# ----------------------------------------------------------------------------
# Sintese
# ----------------------------------------------------------------------------
set_global_assignment -name OPTIMIZATION_MODE BALANCED
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# As ROMs (dataset, pesos da CNN, arvore, twiddles) somam ~200 kB e tem de ir
# para blocos M10K. Em LUTs nao cabem.
set_global_assignment -name AUTO_RAM_RECOGNITION ON
set_global_assignment -name AUTO_ROM_RECOGNITION ON

set_global_assignment -name LAST_QUARTUS_VERSION "20.1.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name BOARD "DE0-CV Development Board"
set_location_assignment PIN_M9 -to CLOCK_50
set_location_assignment PIN_U7 -to KEY[0]
set_location_assignment PIN_W9 -to KEY[1]
set_location_assignment PIN_U13 -to SW[0]
